# GEMINI_API_KEY: Optional/Default AI Studio variable.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Optional API target when running the customer/admin frontends as separate Vite servers.
API_SERVER_URL="http://127.0.0.1:3000"

# Optional API and frontend URLs for a production deployment on separate origins.
# Keep the frontend apps on same-site subdomains to use the existing session cookie safely.
# VITE_API_BASE_URL="https://api.example.com/api"
# VITE_ADMIN_APP_URL="https://admin.example.com/"
# VITE_CUSTOMER_APP_URL="https://shop.example.com/"
# CORS_ORIGINS="https://admin.example.com,https://shop.example.com"

# Session HMAC signing secret
SESSION_SECRET="your-strong-random-session-secret"

# Optional PostgreSQL connections. Configure only the stores you want to use.
# DATABASE_URL stores the app's transactional state in the StoreState JSONB table.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_EXISTING_DATABASE?schema=public"
# AUTH_DATABASE_URL stores customer signups in the waffle_auth_users table (passwords are bcrypt hashed).
AUTH_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_EXISTING_DATABASE"
# POSTS_DATABASE_URL is used by the optional Posts data view.
POSTS_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/YOUR_EXISTING_DATABASE"
